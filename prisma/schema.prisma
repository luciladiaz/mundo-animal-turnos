// Schema de la base de datos — Mundo Animal (gestión de turnos)
//
// Decisión de diseño: fecha/horaInicio/horaFin se guardan como strings
// ("2026-07-15", "09:00") en vez de DateTime. Como la zona horaria de la app
// está fija en America/Argentina/Buenos_Aires (sin horario de verano desde 2009),
// esto evita por completo bugs de conversión UTC/local — lo que ves en la base
// es literalmente la hora de pared que el cliente reservó.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // pooled (transaction mode) — para las consultas normales de la app
  directUrl = env("DIRECT_URL") // conexión directa — solo Prisma Migrate la necesita
}

enum EstadoTurno {
  PENDIENTE // recién cargado, todavía sin confirmar con el cliente
  CONFIRMADO
  CANCELADO
  COMPLETADO // asistió
  NO_ASISTIO
}

enum OrigenTurno {
  MANUAL // cargado por el local desde el panel admin
  CLIENTE // reservado por el cliente desde el link público
}

model Servicio {
  id          String   @id @default(cuid())
  nombre      String
  descripcion String?
  precio      Float?
  activo      Boolean  @default(true)
  turnos      Turno[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ConfiguracionNegocio {
  id              String  @id @default(cuid())
  nombre          String
  logoUrl         String?
  colorPrimario   String  @default("#0F766E")
  colorSecundario String  @default("#F59E0B")
  direccion       String?
  telefono        String?
  bufferMinutos   Int     @default(10)
}

// Uno o más bloques de atención por día de semana (ej. Lunes 09:00-13:00 y 15:00-19:00).
// Un día sin ningún bloque = día cerrado.
model HorarioBloque {
  id         String @id @default(cuid())
  diaSemana  Int // 0 = domingo, 1 = lunes ... 6 = sábado
  horaInicio String // "09:00"
  horaFin    String // "13:00"

  @@index([diaSemana])
}

model Turno {
  id String @id @default(cuid())

  servicio   Servicio @relation(fields: [servicioId], references: [id])
  servicioId String

  fecha      String // "2026-07-15"
  horaInicio String // "09:00"
  horaFin    String // "09:30" — calculada: horaInicio + duración del servicio (el buffer se aplica al chequear disponibilidad, no se suma acá)

  clienteNombre   String
  clienteTelefono String
  clienteEmail    String?
  mascotaNombre   String
  mascotaEspecie  String?
  notas           String?

  estado    EstadoTurno @default(PENDIENTE)
  // Se determina en el servidor a partir de la sesión (no viene del body), para que
  // no pueda falsearse desde el link público — ver POST /api/turnos.
  origen    OrigenTurno @default(CLIENTE)
  createdAt DateTime    @default(now())

  // Vínculo con las fichas. Los campos cliente*/mascota* de arriba se conservan tal
  // cual se cargaron (historial fiel); estas relaciones se completan solas al crear
  // el turno, buscando al tutor por teléfono — ver src/lib/fichas.ts.
  tutor     Tutor?     @relation(fields: [tutorId], references: [id], onDelete: SetNull)
  tutorId   String?
  mascota   Mascota?   @relation(fields: [mascotaId], references: [id], onDelete: SetNull)
  mascotaId String?
  consultas Consulta[]

  @@index([fecha])
  @@index([servicioId, fecha])
  @@index([tutorId])
  @@index([mascotaId])
}

// Ficha del dueño/responsable. Se identifica por teléfono: telefonoClave son los
// últimos 10 dígitos (sin espacios, guiones ni prefijos), así "299 4123456",
// "+54 9 2994123456" y "2994123456" caen en la misma ficha.
model Tutor {
  id                       String    @id @default(cuid())
  nombre                   String
  telefono                 String
  telefonoClave            String    @unique
  email                    String?
  dni                      String?
  direccion                String?
  notas                    String?
  // Ley 25.326: consentimiento para recibir recordatorios por WhatsApp, con fecha.
  aceptaRecordatorios      Boolean   @default(false)
  aceptaRecordatoriosFecha DateTime?
  mascotas                 Mascota[]
  turnos                   Turno[]
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt
}

model Mascota {
  id              String     @id @default(cuid())
  tutor           Tutor      @relation(fields: [tutorId], references: [id])
  tutorId         String
  nombre          String
  nombreClave     String // nombre en minúsculas y sin espacios de más, para reconocerla al reservar
  especie         String? // "Perro" | "Gato" | otro texto libre
  raza            String?
  sexo            String? // "Macho" | "Hembra"
  castrado        Boolean?
  fechaNacimiento String? // "2021-03-15", mismo criterio que las fechas de Turno
  color           String?
  microchip       String?
  pesoKg          Float?
  fotoUrl         String?
  // Avisos que se muestran destacados al abrir la ficha (alergias, "muerde", etc.).
  alertas         String?
  notas           String?
  fallecida       Boolean    @default(false)
  turnos          Turno[]
  consultas       Consulta[]
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@index([tutorId, nombreClave])
}

// Fechas puntuales sin atención (feriados, cierres especiales) — distinto del
// horario semanal fijo de HorarioBloque. Un día acá bloquea la reserva sin
// importar qué diga el horario habitual de ese día de la semana.
model DiaCerrado {
  id     String  @id @default(cuid())
  fecha  String  @unique // "2026-12-25"
  motivo String? // ej: "Feriado", opcional

  @@index([fecha])
}

model AdminUser {
  id           String   @id @default(cuid())
  nombre       String   @default("Usuario")
  email        String   @unique
  passwordHash String
  // esAdmin: acceso total + único rol que puede gestionar usuarios (no configurable por tab, por seguridad).
  esAdmin      Boolean  @default(false)
  // Pestañas habilitadas cuando esAdmin=false: "turnos" | "servicios" | "configuracion".
  // Dashboard queda siempre visible para cualquier usuario activo, y Usuarios es exclusivo de esAdmin.
  permisos     String[] @default([])
  activo       Boolean  @default(true)
}

// Historia clínica: una entrada por consulta. Solo la ven admin y usuarios con permiso
// "historia" (veterinarios) — el control está en el servidor, ver src/app/api/consultas.
// No se borran: cada edición guarda antes la versión anterior en ConsultaCambio.
model Consulta {
  id        String  @id @default(cuid())
  mascota   Mascota @relation(fields: [mascotaId], references: [id])
  mascotaId String
  turno     Turno?  @relation(fields: [turnoId], references: [id], onDelete: SetNull)
  turnoId   String?

  fecha     String // "2026-09-28"
  motivo    String
  // Lo que cuenta el tutor: síntomas, desde cuándo, apetito, etc.
  anamnesis String?

  // Examen: lo rápido arriba, el resto opcional.
  pesoKg                 Float?
  temperatura            Float? // °C
  frecuenciaCardiaca     Int? // latidos por minuto
  frecuenciaRespiratoria Int? // respiraciones por minuto
  condicionCorporal      Int? // escala WSAVA 1 a 9
  mucosas                String?
  hidratacion            String?
  examen                 String? // hallazgos del examen

  diagnostico    String?
  tratamiento    String? // medicación, dosis, vía, frecuencia, duración e indicaciones
  estudios       String? // estudios pedidos o resultados
  proximoControl String? // "2026-10-05"

  autorNombre String // quién la cargó (nombre del usuario en ese momento)
  adjuntos    AdjuntoConsulta[]
  cambios     ConsultaCambio[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([mascotaId, fecha])
}

// Archivos de la consulta (análisis, radiografías, recetas). La URL del storage nunca
// se manda al navegador: se descargan por /api/adjuntos/[id], que controla el permiso.
model AdjuntoConsulta {
  id         String   @id @default(cuid())
  consulta   Consulta @relation(fields: [consultaId], references: [id])
  consultaId String
  nombre     String
  tipo       String
  tamanio    Int
  url        String
  subidoPor  String
  createdAt  DateTime @default(now())

  @@index([consultaId])
}

// Versión anterior de una consulta cada vez que se edita (quién, cuándo y qué decía).
model ConsultaCambio {
  id              String   @id @default(cuid())
  consulta        Consulta @relation(fields: [consultaId], references: [id])
  consultaId      String
  datosAnteriores Json
  editadoPor      String
  createdAt       DateTime @default(now())

  @@index([consultaId])
}
