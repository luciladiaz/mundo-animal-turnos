// Schema de la base de datos — Mundo Animal (gestión de turnos)
//
// Decisión de diseño: fecha/horaInicio/horaFin se guardan como strings
// ("2026-07-15", "09:00") en vez de DateTime. Como la zona horaria de la app
// está fija en America/Argentina/Buenos_Aires (sin horario de verano desde 2009),
// esto evita por completo bugs de conversión UTC/local — lo que ves en la base
// es literalmente la hora de pared que el cliente reservó.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // pooled (transaction mode) — para las consultas normales de la app
  directUrl = env("DIRECT_URL") // conexión directa — solo Prisma Migrate la necesita
}

enum EstadoTurno {
  PENDIENTE // recién cargado, todavía sin confirmar con el cliente
  CONFIRMADO
  CANCELADO
  COMPLETADO // asistió
  NO_ASISTIO
}

enum OrigenTurno {
  MANUAL // cargado por el local desde el panel admin
  CLIENTE // reservado por el cliente desde el link público
}

model Servicio {
  id          String      @id @default(cuid())
  nombre      String
  descripcion String?
  precio      Float?
  activo      Boolean     @default(true)
  turnos      Turno[]
  ventaItems  VentaItem[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model ConfiguracionNegocio {
  id              String  @id @default(cuid())
  nombre          String
  logoUrl         String?
  colorPrimario   String  @default("#0F766E")
  colorSecundario String  @default("#F59E0B")
  direccion       String?
  telefono        String?
  bufferMinutos   Int     @default(10)
}

// Uno o más bloques de atención por día de semana (ej. Lunes 09:00-13:00 y 15:00-19:00).
// Un día sin ningún bloque = día cerrado.
model HorarioBloque {
  id         String @id @default(cuid())
  diaSemana  Int // 0 = domingo, 1 = lunes ... 6 = sábado
  horaInicio String // "09:00"
  horaFin    String // "13:00"

  @@index([diaSemana])
}

model Turno {
  id String @id @default(cuid())

  servicio   Servicio @relation(fields: [servicioId], references: [id])
  servicioId String

  fecha      String // "2026-07-15"
  horaInicio String // "09:00"
  horaFin    String // "09:30" — calculada: horaInicio + duración del servicio (el buffer se aplica al chequear disponibilidad, no se suma acá)

  clienteNombre   String
  clienteTelefono String
  clienteEmail    String?
  mascotaNombre   String
  mascotaEspecie  String?
  notas           String?

  estado    EstadoTurno @default(PENDIENTE)
  // Se determina en el servidor a partir de la sesión (no viene del body), para que
  // no pueda falsearse desde el link público — ver POST /api/turnos.
  origen    OrigenTurno @default(CLIENTE)
  createdAt DateTime    @default(now())

  // Vínculo con las fichas. Los campos cliente*/mascota* de arriba se conservan tal
  // cual se cargaron (historial fiel); estas relaciones se completan solas al crear
  // el turno, buscando al tutor por teléfono — ver src/lib/fichas.ts.
  tutor     Tutor?     @relation(fields: [tutorId], references: [id], onDelete: SetNull)
  tutorId   String?
  mascota   Mascota?   @relation(fields: [mascotaId], references: [id], onDelete: SetNull)
  mascotaId String?
  consultas Consulta[]

  @@index([fecha])
  @@index([servicioId, fecha])
  @@index([tutorId])
  @@index([mascotaId])
}

// Ficha del dueño/responsable. Se identifica por teléfono: telefonoClave son los
// últimos 10 dígitos (sin espacios, guiones ni prefijos), así "299 4123456",
// "+54 9 2994123456" y "2994123456" caen en la misma ficha.
model Tutor {
  id                       String                @id @default(cuid())
  nombre                   String
  telefono                 String
  telefonoClave            String                @unique
  email                    String?
  dni                      String?
  direccion                String?
  notas                    String?
  // Ley 25.326: consentimiento para recibir recordatorios por WhatsApp, con fecha.
  aceptaRecordatorios      Boolean               @default(false)
  aceptaRecordatoriosFecha DateTime?
  mascotas                 Mascota[]
  turnos                   Turno[]
  ventas                   Venta[]
  pagosCuentaCorriente     PagoCuentaCorriente[]
  createdAt                DateTime              @default(now())
  updatedAt                DateTime              @updatedAt
}

model Mascota {
  id              String        @id @default(cuid())
  tutor           Tutor         @relation(fields: [tutorId], references: [id])
  tutorId         String
  nombre          String
  nombreClave     String // nombre en minúsculas y sin espacios de más, para reconocerla al reservar
  especie         String? // "Perro" | "Gato" | otro texto libre
  raza            String?
  sexo            String? // "Macho" | "Hembra"
  castrado        Boolean?
  fechaNacimiento String? // "2021-03-15", mismo criterio que las fechas de Turno
  color           String?
  microchip       String?
  pesoKg          Float?
  fotoUrl         String?
  // Avisos que se muestran destacados al abrir la ficha (alergias, "muerde", etc.).
  alertas         String?
  notas           String?
  fallecida       Boolean       @default(false)
  turnos          Turno[]
  consultas       Consulta[]
  aplicaciones    Aplicacion[]
  internaciones   Internacion[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([tutorId, nombreClave])
}

// Fechas puntuales sin atención (feriados, cierres especiales) — distinto del
// horario semanal fijo de HorarioBloque. Un día acá bloquea la reserva sin
// importar qué diga el horario habitual de ese día de la semana.
model DiaCerrado {
  id     String  @id @default(cuid())
  fecha  String  @unique // "2026-12-25"
  motivo String? // ej: "Feriado", opcional

  @@index([fecha])
}

model AdminUser {
  id           String   @id @default(cuid())
  nombre       String   @default("Usuario")
  email        String   @unique
  passwordHash String
  // esAdmin: acceso total + único rol que puede gestionar usuarios (no configurable por tab, por seguridad).
  esAdmin      Boolean  @default(false)
  // Pestañas habilitadas cuando esAdmin=false: "turnos" | "servicios" | "configuracion".
  // Dashboard queda siempre visible para cualquier usuario activo, y Usuarios es exclusivo de esAdmin.
  permisos     String[] @default([])
  activo       Boolean  @default(true)
}

// Historia clínica: una entrada por consulta. Solo la ven admin y usuarios con permiso
// "historia" (veterinarios) — el control está en el servidor, ver src/app/api/consultas.
// No se borran: cada edición guarda antes la versión anterior en ConsultaCambio.
model Consulta {
  id        String  @id @default(cuid())
  mascota   Mascota @relation(fields: [mascotaId], references: [id])
  mascotaId String
  turno     Turno?  @relation(fields: [turnoId], references: [id], onDelete: SetNull)
  turnoId   String?

  fecha     String // "2026-09-28"
  motivo    String
  // Lo que cuenta el tutor: síntomas, desde cuándo, apetito, etc.
  anamnesis String?

  // Examen: lo rápido arriba, el resto opcional.
  pesoKg                 Float?
  temperatura            Float? // °C
  frecuenciaCardiaca     Int? // latidos por minuto
  frecuenciaRespiratoria Int? // respiraciones por minuto
  condicionCorporal      Int? // escala WSAVA 1 a 9
  mucosas                String?
  hidratacion            String?
  examen                 String? // hallazgos del examen

  diagnostico    String?
  tratamiento    String? // medicación, dosis, vía, frecuencia, duración e indicaciones
  estudios       String? // estudios pedidos o resultados
  proximoControl String? // "2026-10-05"

  autorNombre  String // quién la cargó (nombre del usuario en ese momento)
  adjuntos     AdjuntoConsulta[]
  aplicaciones Aplicacion[]
  cambios      ConsultaCambio[]
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([mascotaId, fecha])
}

// Archivos de la consulta (análisis, radiografías, recetas). La URL del storage nunca
// se manda al navegador: se descargan por /api/adjuntos/[id], que controla el permiso.
model AdjuntoConsulta {
  id         String   @id @default(cuid())
  consulta   Consulta @relation(fields: [consultaId], references: [id])
  consultaId String
  nombre     String
  tipo       String
  tamanio    Int
  url        String
  subidoPor  String
  createdAt  DateTime @default(now())

  @@index([consultaId])
}

// Versión anterior de una consulta cada vez que se edita (quién, cuándo y qué decía).
model ConsultaCambio {
  id              String   @id @default(cuid())
  consulta        Consulta @relation(fields: [consultaId], references: [id])
  consultaId      String
  datosAnteriores Json
  editadoPor      String
  createdAt       DateTime @default(now())

  @@index([consultaId])
}

enum TipoAplicacion {
  VACUNA
  DESPARASITACION_INTERNA
  DESPARASITACION_EXTERNA
}

// Vacunas y desparasitaciones aplicadas (el "carnet"). proximaFecha es lo que alimenta
// la pestaña Recordatorios: se calcula sola según el producto y el veterinario la puede
// cambiar. Cuando se aplica una dosis nueva del mismo producto, la anterior queda
// "resuelta" y deja de aparecer en los recordatorios.
model Aplicacion {
  id            String         @id @default(cuid())
  mascota       Mascota        @relation(fields: [mascotaId], references: [id])
  mascotaId     String
  consulta      Consulta?      @relation(fields: [consultaId], references: [id], onDelete: SetNull)
  consultaId    String?
  tipo          TipoAplicacion
  producto      String // "Antirrábica", "Séxtuple", "Pipeta"...
  productoClave String // producto en minúsculas, para reconocer la dosis siguiente
  lote          String?
  fecha         String // "2026-09-28"
  proximaFecha  String? // null = no hay que repetirla
  notas         String?
  aplicadoPor   String

  resuelta               Boolean   @default(false)
  recordatorioEnviado    DateTime?
  recordatorioEnviadoPor String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([mascotaId, productoClave])
  @@index([resuelta, proximaFecha])
}

// ============================================================================
// VENTAS, CAJA Y STOCK
// Reglas (ver src/lib/stock.ts, src/lib/ventas.ts, src/lib/caja.ts):
//  * Montos SIEMPRE en centavos (Int): nada de Float para plata.
//  * El stock nunca se edita a mano: cada cambio es un MovimientoStock, y
//    LoteStock.cantidad / Producto.stock son la suma de esos movimientos
//    (se guardan para leer rápido; /api/stock/control verifica que coincidan).
//  * Se puede vender sin stock: queda negativo en el lote genérico del producto.
//  * Sin caja abierta no se vende, no se anula y no se cobra cuenta corriente.
//  * Una caja cerrada no se modifica nunca: lo que pasa después va a la caja abierta.
//  * Nada se borra: las ventas se anulan con motivo.
// ============================================================================

model CategoriaProducto {
  id        String     @id @default(cuid())
  nombre    String     @unique
  activa    Boolean    @default(true)
  productos Producto[]
  createdAt DateTime   @default(now())
}

model MedioPago {
  id                   String                @id @default(cuid())
  nombre               String                @unique
  activo               Boolean               @default(true)
  orden                Int                   @default(0)
  // El efectivo es el único medio que arranca la caja con un monto inicial.
  esEfectivo           Boolean               @default(false)
  pagos                VentaPago[]
  movimientos          MovimientoCaja[]
  conteos              CajaConteo[]
  pagosCuentaCorriente PagoCuentaCorriente[]
}

model Producto {
  id                  String            @id @default(cuid())
  nombre              String
  nombreClave         String // minúsculas, sin acentos: para buscar y evitar duplicados
  categoria           CategoriaProducto @relation(fields: [categoriaId], references: [id])
  categoriaId         String
  precioVenta         Int // centavos
  costo               Int? // centavos
  stockMinimo         Int               @default(0)
  // Con vencimiento: el stock se carga por lote y al vender sale primero lo que vence antes.
  controlaVencimiento Boolean           @default(false)
  activo              Boolean           @default(true)
  stock               Int               @default(0) // suma de sus lotes
  lotes               LoteStock[]
  movimientos         MovimientoStock[]
  ventaItems          VentaItem[]
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  @@index([nombreClave])
}

// Cada producto tiene un lote "genérico" (codigo y vencimiento null), que es el único
// que puede quedar negativo (ventas sin stock). Los demás son lotes reales con vencimiento.
model LoteStock {
  id          String            @id @default(cuid())
  producto    Producto          @relation(fields: [productoId], references: [id])
  productoId  String
  generico    Boolean           @default(false)
  codigo      String?
  vencimiento String? // "2027-03-31"
  cantidad    Int               @default(0)
  movimientos MovimientoStock[]
  createdAt   DateTime          @default(now())

  @@index([productoId])
}

enum TipoMovimientoStock {
  INICIAL
  COMPRA
  VENTA
  ANULACION_VENTA
  AJUSTE
}

model MovimientoStock {
  id          String              @id @default(cuid())
  producto    Producto            @relation(fields: [productoId], references: [id])
  productoId  String
  lote        LoteStock           @relation(fields: [loteId], references: [id])
  loteId      String
  tipo        TipoMovimientoStock
  cantidad    Int // con signo: + entra, - sale
  ventaItem   VentaItem?          @relation(fields: [ventaItemId], references: [id])
  ventaItemId String?
  motivo      String?
  usuario     String
  createdAt   DateTime            @default(now())

  @@index([productoId, createdAt])
  @@index([loteId])
  @@index([ventaItemId])
}

enum EstadoCaja {
  ABIERTA
  CERRADA
}

// Solo puede haber UNA caja ABIERTA: lo garantiza un índice único parcial creado en
// la migración (Prisma no los soporta en el schema).
model Caja {
  id                   String                @id @default(cuid())
  estado               EstadoCaja            @default(ABIERTA)
  abiertaEn            DateTime              @default(now())
  abiertaPor           String
  efectivoInicial      Int // centavos
  cerradaEn            DateTime?
  cerradaPor           String?
  observacionesCierre  String?
  movimientos          MovimientoCaja[]
  conteos              CajaConteo[]
  ventas               Venta[]               @relation("VentasDeCaja")
  anulaciones          Venta[]               @relation("AnulacionesEnCaja")
  pagosCuentaCorriente PagoCuentaCorriente[]

  @@index([estado])
}

enum TipoMovimientoCaja {
  VENTA
  ANULACION_VENTA
  COBRO_CUENTA_CORRIENTE
  GASTO
  INGRESO
  RETIRO
}

model MovimientoCaja {
  id                    String               @id @default(cuid())
  caja                  Caja                 @relation(fields: [cajaId], references: [id])
  cajaId                String
  medioPago             MedioPago            @relation(fields: [medioPagoId], references: [id])
  medioPagoId           String
  tipo                  TipoMovimientoCaja
  monto                 Int // centavos, con signo: + entra, - sale
  venta                 Venta?               @relation(fields: [ventaId], references: [id])
  ventaId               String?
  pagoCuentaCorriente   PagoCuentaCorriente? @relation(fields: [pagoCuentaCorrienteId], references: [id])
  pagoCuentaCorrienteId String?
  descripcion           String?
  usuario               String
  createdAt             DateTime             @default(now())

  @@index([cajaId])
  @@index([ventaId])
}

// Lo que se contó al cerrar, por medio de pago (esperado lo calcula el sistema).
model CajaConteo {
  id          String    @id @default(cuid())
  caja        Caja      @relation(fields: [cajaId], references: [id])
  cajaId      String
  medioPago   MedioPago @relation(fields: [medioPagoId], references: [id])
  medioPagoId String
  esperado    Int
  contado     Int

  @@unique([cajaId, medioPagoId])
}

enum EstadoVenta {
  ACTIVA
  ANULADA
}

model Venta {
  id              String           @id @default(cuid())
  numero          Int              @unique @default(autoincrement())
  caja            Caja             @relation("VentasDeCaja", fields: [cajaId], references: [id])
  cajaId          String
  tutor           Tutor?           @relation(fields: [tutorId], references: [id])
  tutorId         String?
  total           Int // centavos
  // total - pagado = lo que queda en la cuenta corriente del tutor
  pagado          Int
  observaciones   String?
  usuario         String
  estado          EstadoVenta      @default(ACTIVA)
  anuladaEn       DateTime?
  anuladaPor      String?
  motivoAnulacion String?
  cajaAnulacion   Caja?            @relation("AnulacionesEnCaja", fields: [cajaAnulacionId], references: [id])
  cajaAnulacionId String?
  items           VentaItem[]
  pagos           VentaPago[]
  movimientosCaja MovimientoCaja[]
  createdAt       DateTime         @default(now())

  @@index([cajaId])
  @@index([tutorId])
  @@index([createdAt])
}

model VentaItem {
  id               String            @id @default(cuid())
  venta            Venta             @relation(fields: [ventaId], references: [id])
  ventaId          String
  producto         Producto?         @relation(fields: [productoId], references: [id])
  productoId       String?
  servicio         Servicio?         @relation(fields: [servicioId], references: [id])
  servicioId       String?
  descripcion      String // nombre al momento de vender
  cantidad         Int
  precioLista      Int // centavos, el precio cargado en el sistema
  precioUnitario   Int // centavos, el que se cobró (puede tener descuento)
  subtotal         Int
  movimientosStock MovimientoStock[]

  @@index([ventaId])
  @@index([productoId])
}

model VentaPago {
  id          String    @id @default(cuid())
  venta       Venta     @relation(fields: [ventaId], references: [id])
  ventaId     String
  medioPago   MedioPago @relation(fields: [medioPagoId], references: [id])
  medioPagoId String
  monto       Int

  @@index([ventaId])
}

// Pago de deuda de cuenta corriente: entra a la caja del día en que se paga.
model PagoCuentaCorriente {
  id          String           @id @default(cuid())
  tutor       Tutor            @relation(fields: [tutorId], references: [id])
  tutorId     String
  caja        Caja             @relation(fields: [cajaId], references: [id])
  cajaId      String
  medioPago   MedioPago        @relation(fields: [medioPagoId], references: [id])
  medioPagoId String
  monto       Int
  usuario     String
  movimientos MovimientoCaja[]
  createdAt   DateTime         @default(now())

  @@index([tutorId])
}

// ============================================================================
// INTERNACIONES
//  * Una sola internación activa por mascota (índice único parcial en la migración).
//  * Cada parte tiene dos textos: notaClinica (solo veterinario, permiso "historia")
//    y parteFamilia (lo que la secretaria le manda al tutor, permiso "internados").
//  * Hoja de medicación: cada toma queda registrada con quién y cuándo.
// ============================================================================

enum EstadoInternacion {
  INTERNADA
  ALTA
  DERIVADA
  FALLECIDA
}

enum EstadoParte {
  ESTABLE
  OBSERVACION
  DELICADO
}

model Internacion {
  id               String                  @id @default(cuid())
  mascota          Mascota                 @relation(fields: [mascotaId], references: [id])
  mascotaId        String
  estado           EstadoInternacion       @default(INTERNADA)
  ingresoEn        DateTime                @default(now())
  motivo           String
  diagnostico      String?
  veterinario      String // a cargo
  creadaPor        String
  // Egreso (alta, derivación o fallecimiento)
  egresoEn         DateTime?
  egresoPor        String?
  notaEgreso       String? // clínica, solo veterinario
  indicacionesAlta String? // para la familia (se manda por WhatsApp)
  altaEnviadaEn    DateTime?
  altaEnviadaPor   String?
  partes           ParteInternacion[]
  medicaciones     MedicacionInternacion[]
  estudios         EstudioInternacion[]
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  @@index([estado])
  @@index([mascotaId])
}

model ParteInternacion {
  id            String      @id @default(cuid())
  internacion   Internacion @relation(fields: [internacionId], references: [id])
  internacionId String
  estado        EstadoParte
  parteFamilia  String
  notaClinica   String?
  autor         String
  enviadoEn     DateTime?
  enviadoPor    String?
  // Solo los admin cargan y corrigen partes; queda registrado quién corrigió y cuándo.
  editadoEn     DateTime?
  editadoPor    String?
  createdAt     DateTime    @default(now())

  @@index([internacionId, createdAt])
}

model MedicacionInternacion {
  id              String           @id @default(cuid())
  internacion     Internacion      @relation(fields: [internacionId], references: [id])
  internacionId   String
  medicamento     String
  dosis           String // "250 mg", "1 comprimido", "5 ml"
  via             String? // oral, IV, SC, IM...
  // Cada cuántas horas; null = según necesidad (no calcula próxima toma).
  frecuenciaHoras Int?
  indicaciones    String?
  activa          Boolean          @default(true)
  creadaPor       String
  suspendidaEn    DateTime?
  suspendidaPor   String?
  tomas           TomaMedicacion[]
  createdAt       DateTime         @default(now())

  @@index([internacionId])
}

model TomaMedicacion {
  id              String                @id @default(cuid())
  medicacion      MedicacionInternacion @relation(fields: [medicacionId], references: [id])
  medicacionId    String
  administradaEn  DateTime              @default(now())
  administradaPor String
  observaciones   String?

  @@index([medicacionId, administradaEn])
}

// Estudios hechos durante la internación (análisis, radiografías, ecografías...),
// con sus archivos. Clínico: solo veterinario. Los archivos se sirven por
// /api/adjuntos-estudio/[id] con control de permiso (la URL real nunca sale al navegador).
model EstudioInternacion {
  id            String           @id @default(cuid())
  internacion   Internacion      @relation(fields: [internacionId], references: [id])
  internacionId String
  tipo          String
  fecha         DateTime         @default(now())
  resultado     String?
  autor         String
  adjuntos      AdjuntoEstudio[]
  createdAt     DateTime         @default(now())

  @@index([internacionId])
}

model AdjuntoEstudio {
  id        String             @id @default(cuid())
  estudio   EstudioInternacion @relation(fields: [estudioId], references: [id])
  estudioId String
  nombre    String
  tipo      String
  tamanio   Int
  url       String
  subidoPor String
  createdAt DateTime           @default(now())

  @@index([estudioId])
}
